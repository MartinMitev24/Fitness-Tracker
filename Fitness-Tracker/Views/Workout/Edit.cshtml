@model WorkoutViewModel;

@{
	ViewBag.Title = $"Edit workout";
	IEnumerable<ExerciseToChooseViewModel> exerciseToChooses = ViewBag.Exercises;
	var muscleGroups = ViewBag.MuscleGroups;
	List<IntensityFormModel> workoutData = ViewBag.WorkoutData;
}

<h1 class="text-center">@ViewBag.Title</h1>
<form method="post">
	<div class="form-group visually-hidden">
	<input type="text" value="@Model.Id"/>
		<label asp-for="Intensities"></label>
		@if (workoutData.Count() > 0)
		{
			foreach (var item in workoutData)
			{
				<div id="intensities" class="input-group justify-content-between w-100 border border-info p-2 m-2">
					<div>
						<p>@exerciseToChooses.First(x => x.Id == item.ExerciseId).Name</p>
					</div>
					<div>
						<p>@exerciseToChooses.First(x => x.Id == item.ExerciseId).MuscleType</p>
					</div>
					<div>
						<p>@item.Weight</p>
					</div>
					<div>
						<p>@item.Reps</p>
					</div>
					<div>
						<p>@item.Sets</p>
					</div>
					<div>
						<p>@item.Time</p>
					</div>
				</div>
			}
		}
	</div>
	<input class="btn btn-light btn-outline-success" type="submit" value="Edit Workout Data" />
</form>

<div>
	<div>
		<h3>Exercises</h3>
		<table class="table table-info table-hover m-1 p-2">
			<thead>
				<tr>
					<th>Exercise</th>
					<th>Weight</th>
					<th>Reps</th>
					<th>Sets</th>
					<th>Avr. time</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var intensity in Model.Intensities)
				{
					<tr>
						<td>@intensity.ExerciseName</td>
						<td>@intensity.LiftedWeight</td>
						<td>@intensity.Reps</td>
						<td>@intensity.Sets</td>
						<td>@intensity.AvarageTimePerSet</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<div>
		<h3>Edited Exercises</h3>
		<!-- Button trigger modal -->
		<button type="button" class="btn btn-light btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addExerciseToWorkout">Add Exercise to Workout</button>
		
		<table class="table table-primary table-hover m-1 p-2">
			<thead>
				<tr>
					<th>Exercise</th>
					<th>Weight</th>
					<th>Reps</th>
					<th>Sets</th>
					<th>Avr. time</th>
				</tr>
			</thead>
			<tbody>
				@if(workoutData.Any())
				{ 
					foreach (var intensity in workoutData)
					{
						<tr>
							<td>@exerciseToChooses.First(e => e.Id == intensity.ExerciseId).Name</td>
							<td>@intensity.Weight</td>
							<td>@intensity.Reps</td>
							<td>@intensity.Sets</td>
							<td>@intensity.Time</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
</div>

<!-- Modal -->
<div class="modal fade" id="addExerciseToWorkout" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addExerciseToWorkoutLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h3 class="modal-title fs-5" id="addExerciseToWorkoutLabel">Add exersice data.</h3>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form id="addExerciseForm">
					<div>
						<select for="muscleGroup" id="muscleGroup" class="form-select w-100 p-2 border-dark border-1" name="muscleGroup">
							<option value="none">Select muscle group</option>
							@foreach (var item in muscleGroups)
							{
								<option value="@item">@item</option>
							}
						</select>
					</div>
					<div id="exerciseSelect">
						<select for="exerciseId" id="exerciseId" class="form-select w-100 mt-2 p-2 border-dark border-1" name="exerciseId">
							<option value="none">Select exercise</option>
							@foreach (var item in exerciseToChooses)
							{
								<option value="@item.Id" data-muscleGroup="@item.MuscleType">@item.Name</option>
							}
						</select>
					</div>
					<div>
						<input for="weight" id="weight" type="text" class="form-control w-100 mt-2 p-2 border-dark border-1" name="weight" placeholder="Weight" />
					</div>
					<div>
						<input for="reps" id="reps" type="text" class="form-control w-100 mt-2 p-2 border-dark border-1" name="reps" placeholder="Repetitions" />
					</div>
					<div>
						<input for="sets" id="sets" type="text" class="form-control w-100 mt-2 p-2 border-dark border-1" name="sets" placeholder="Sets" />
					</div>
					<div>
						<input for="time" id="time" type="text" class="form-control w-100 mt-2 p-2 border-dark border-1" name="time" placeholder="Average time" />
					</div>
					<div>
						<hr class="mt-3 mb-3" />
					</div>
					<div class="container p-0 m-0">
						<button type="submit" class="btn btn-light btn-outline-success w-100">Add Exercise to Workout</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial-name ="_ValidationScriptsPartial" />
	<script src="~/js/jquery.filter.exercises.to.add.js"></script>
	<script src="~/js/jquery.add.exercise.to.workout.js"></script>
	<script>
		var addExerciseUrl = '@Url.Action("AddExerciseInEdit", "Workout")';
	</script>
}